ROLE=api
PORT=3000
DATABASE_URL=postgresql://sorobanpool:sorobanpool@localhost:5432/sorobanpool
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_PUBLIC=sp-public
S3_BUCKET_EVIDENCE=sp-evidence
# Secret values live in a secret manager in staging/production (*_REF). Local dev only below.
S3_ACCESS_KEY_REF=minioadmin
S3_SECRET_KEY_REF=minioadmin
STELLAR_NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_APP_URL=http://localhost:3001

# Optional hardening and operations
RATE_LIMIT_PER_MIN=300
# METRICS_TOKEN=at-least-16-characters   # required to scrape /v1/metrics in production
SPONSOR_MIN_XLM=100                      # alert when the fee sponsor falls below this
OBJECT_STORE=local                       # or s3 (uses the S3_* settings above; S3_REGION defaults to auto)
# SENTRY_DSN=
