# Copy to .env for local development: `cp .env.example .env`. `.env` is git-ignored and loaded at startup;
# variables already set in your shell win over the file. Every value below is for LOCAL DEV ONLY.
# In staging/production, *_REF values point at a secret manager entry, never at a literal.

ROLE=api                                   # api | worker | indexer (one codebase, three roles)
PORT=3000
NODE_ENV=development

# --- Datastores (docker compose up -d postgres redis minio) ---
DATABASE_URL=postgresql://sorobanpool:sorobanpool@localhost:5432/sorobanpool
REDIS_URL=redis://localhost:6379
OBJECT_STORE=local                         # local (EVIDENCE_DIR) or s3 (any S3-compatible: MinIO, R2, AWS)
EVIDENCE_DIR=.evidence
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_PUBLIC=sp-public
S3_BUCKET_EVIDENCE=sp-evidence
S3_ACCESS_KEY_REF=literal:minioadmin
S3_SECRET_KEY_REF=literal:minioadmin

# --- Auth and encryption (dev values; each must be at least 32 characters) ---
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-00000
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-0000
# AES-256-GCM key for PII at rest (KYC results, bank details): base64 of 32 bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_ID=literal:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001
OTP_DEV_ECHO=true                          # returns the OTP in the API response; refused in production

# --- Stellar (testnet only until the audit) ---
STELLAR_NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
DEPLOYMENTS_FILE=deployments/testnet.json  # vendored by scripts/sync-contract-artifacts.sh
# The sponsor pays every fee (users never hold XLM). Create and fund a testnet key, then export it in your shell:
#   stellar keys generate sp-dev --network testnet --fund && export SPONSOR_SECRET=$(stellar keys show sp-dev)
SPONSOR_SECRET_REF=env:SPONSOR_SECRET
# The attestor may only call registry.attest. Locally it can be the same key as the sponsor.
ATTESTOR_SECRET_REF=env:SPONSOR_SECRET

# --- Providers (sandbox/console implementations locally) ---
KYC_PROVIDER=sandbox
KYC_API_KEY_REF=
SMS_PROVIDER=console
SMS_API_KEY_REF=
WHATSAPP_API_KEY_REF=
ANCHOR_DOMAIN=
FX_SOURCES=                                # empty = static rates below; live: er-api,coingecko (required in production)
FX_STATIC=1500,1505                        # NGN per USD, one value per simulated source

# --- Embedded workers for a single-process dev setup ---
INDEXER_EMBEDDED=true
KEEPER_EMBEDDED=true

# --- Operations (optional) ---
RATE_LIMIT_PER_MIN=300
# METRICS_TOKEN=at-least-16-characters    # required to scrape /v1/metrics in production
SPONSOR_MIN_XLM=100                        # alert when the fee sponsor falls below this
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
